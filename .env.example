# ── Үндсэн ──
# Порт 3100/3101 — Loopy (3000/3001)-тэй зэрэг ажиллахад мөргөлдөхгүй.
NODE_ENV=development
PORT=3100
TZ=Asia/Ulaanbaatar
API_BASE_URL=http://localhost:3100
DASHBOARD_URL=http://localhost:3101
CORS_ORIGINS=

# ── Өгөгдлийн сан ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/winfit
DATABASE_SSL=false
DB_LOGGING=false

# ── Redis (B4-ээс хойш outbox worker-т) ──
REDIS_URL=

# ── Нэвтрэлт ──
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Gateway горим: stub | (agent|live) ──
# Хөгжүүлэлтэд гурвуулаа stub — төхөөрөмж, Loopy, банкгүйгээр бүрэн ажиллана.
DEVICE_GATEWAY=stub
LOOPY_MODE=stub
BONUM_MODE=stub

# ── Stub зан төлөв (эвдрэлийг дуурайлгаж retry-г турших) ──
STUB_FAILURE_RATE=0.05
STUB_LATENCY_MIN_MS=100
STUB_LATENCY_MAX_MS=400
STUB_DEVICE_OFFLINE=false
STUB_FACE_AUTO_ENROLL=30

# ── Outbox дараалал ──
# Backoff (секунд). Хөгжүүлэлтэд богино — production-д 60,300,1800,7200,21600
OUTBOX_BACKOFF_SEC=3,8,20,60,180
OUTBOX_BATCH_SIZE=10

# ── Loopy Partner API (LOOPY_MODE=live үед) ──
LOOPY_API_URL=
LOOPY_API_KEY=
LOOPY_PROGRAM_ID=
WINFIT_LOOPY_BRANCH_ID=
LOOPY_RATE_LIMIT_PER_MIN=60
LOOPY_WEBHOOK_SECRET=

# ── Bonum (BONUM_MODE=live үед) ──
BONUM_API_URL=https://testapi.bonum.mn
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_CHECKSUM_KEY=
BONUM_WEBHOOK_SECRET=
BONUM_RETURN_URL=
INVOICE_TTL_SEC=3600

# ── Hikvision терминал ──
# ЗААВАЛ БИШ. Хаяг, порт, нэр, нууц үгийг дэлгэцээс (Терминал →
# Терминалын холболт) тохируулж DB-д хадгална — нууц үг нь нууцлагдана.
# Эдгээр нь зөвхөн DB хоосон үеийн анхны утга.
#
# ⚠ Порт нь 80 (ISAPI). 8000 бол SDK-ынх — ажиллахгүй.
HIK_HOST=
HIK_PORT=80
HIK_USER=winfit
HIK_PASSWORD=
HIK_HTTPS=false

# ── Hikvision ──
HIK_PLAN_TEMPLATE_NO=1
HIK_DOOR_NO=1

# ── Сануулга ──
REMINDER_MILESTONES=T-7,T-3,T-1,T0
REMINDER_HOUR=9

# ── Мэдэгдлийн мэйл (Resend) ──
# `stub` үед ЖИНХЭНЭ хаяг руу юу ч явахгүй, зөвхөн лог. Хөгжүүлэлтийн
# үед санамсаргүй мэйл илгээх нь буцаах боломжгүй алдаа.
#
# ⚠ Домэйн эзэмшдэг нь ХАНГАЛТГҮЙ: winfit.mn-ий DNS дээр SPF ба DKIM
# бичлэг нэмэхгүй бол мэйл спам руу орно (Resend заавар өгнө).
MAIL_MODE=stub
RESEND_API_KEY=
MAIL_FROM=
# Энэ дүнгээс дээш төлбөрт ТЭР ДАРУЙ мэдэгдэнэ (₮)
MAIL_LARGE_PAYMENT=1000000
